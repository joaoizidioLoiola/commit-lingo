# ============================================================================
# Commit Lingo — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit secrets.
#
# In production (Vercel), set these in:
#   Project Settings → Environment Variables
# ============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development

# Optional: override the self-hosted port (default 3000)
# PORT=3004

# ---- OAuth (Manus auth provider) -------------------------------------------
# Get these from the Manus dashboard for your project.
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ---- Session signing --------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ---- Database ---------------------------------------------------------------
# MySQL connection string. Example:
# DATABASE_URL=mysql://user:pass@host:3306/commitlingo
DATABASE_URL=

# ---- LLM provider (NVIDIA NIM) ---------------------------------------------
# Used by the translate tRPC procedure.
RIVA_API_KEY=
# RIVA_URL=https://integrate.api.nvidia.com

# ---- Storage (Manus Forge / S3) --------------------------------------------
# Optional: only needed if you use the storage proxy.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ---- AWS S3 (alternative to Manus Forge) ------------------------------------
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Analytics (Umami, optional) -------------------------------------------
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
